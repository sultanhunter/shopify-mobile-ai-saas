NEXTJS_APP_BASE_URL=http://localhost:3000

# Legacy alias
APP_BASE_URL=

# Expo backend base URL is injected by runner per dev session (EXPO_PUBLIC_RUNTIME_BACKEND_URL)
# Legacy static URL aliases (not used by current baseline generator)
MOBILE_EXPO_BACKEND_BASE_URL=
MOBILE_RUNTIME_BACKEND_BASE_URL=
MOBILE_BACKEND_BASE_URL=

# Default workspace layout sent to workspace-create tasks
WORKSPACE_MOBILE_APP_DIR=mobile
WORKSPACE_EXPO_BACKEND_DIR=expo-backend
WORKSPACE_EXPO_BACKEND_PORT=4100

# Legacy aliases
WORKSPACE_BACKEND_DIR=
WORKSPACE_BACKEND_PORT=

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECTS_TABLE=projects
SUPABASE_TASKS_TABLE=tasks
SUPABASE_RUNTIME_CONFIG_TABLE=project_runtime_config
SUPABASE_RUNTIME_SECRETS_TABLE=project_runtime_secrets
SUPABASE_RUNTIME_SYNC_OUTBOX_TABLE=runtime_sync_outbox

# Optional GitHub automation (used for auto repo create + commits)
GITHUB_TOKEN=
GITHUB_OWNER=

# Optional Shopify app credentials (for full OAuth implementation)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_OAUTH_SCOPES=read_products,read_orders,write_checkouts

# OAuth + token security
SHOPIFY_OAUTH_STATE_SECRET=
SHOPIFY_TOKEN_ENCRYPTION_SECRET=

# Customer Account API (optional defaults)
# Client ID is now stored per-project in DB via workspace setup UI/API
SHOPIFY_CUSTOMER_ACCOUNT_SCOPES=openid,email,customer-account-api:full
SHOPIFY_CUSTOMER_AUTH_CALLBACK_URL=

# LLM layer (provider + model are swappable)
LLM_PROVIDER=opencode-server
LLM_MODEL=gemini-3.1-flash-lite-preview

# External runner server (recommended for Vercel deployments)
RUNNER_SERVER_BASE_URL=http://localhost:3100
RUNNER_SERVER_TOKEN=
RUNNER_SERVER_TIMEOUT_MS=600000

# Runtime sync from control-plane -> expo-backend
RUNTIME_SYNC_TOKEN=
RUNTIME_SYNC_TIMEOUT_MS=15000

# Neon runtime database provisioning (per project DB)
NEON_ADMIN_DATABASE_URL=
NEON_RUNTIME_DATABASE_PREFIX=shopify_runtime_
NEON_RUNTIME_ROLE_PREFIX=shopify_runtime_

# Legacy aliases (optional backward compatibility)
AI_SERVER_BASE_URL=
AI_SERVER_TOKEN=
AI_SERVER_TIMEOUT_MS=

# External Expo scaffold service (defaults to runner server values when omitted)
EXPO_SCAFFOLD_SERVER_BASE_URL=http://localhost:3100
EXPO_SCAFFOLD_SERVER_TOKEN=
EXPO_SCAFFOLD_TIMEOUT_MS=240000

# Optional direct fallback (if LLM_PROVIDER=gemini)
VERTEX_API_KEY=
GEMINI_API_KEY=
