APP_BASE_URL=http://localhost:3000

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECTS_TABLE=projects
SUPABASE_TASKS_TABLE=tasks

# Optional GitHub automation (used for auto repo create + commits)
GITHUB_TOKEN=
GITHUB_OWNER=

# Optional Shopify app credentials (for full OAuth implementation)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_OAUTH_SCOPES=read_products,read_orders,write_checkouts

# OAuth + token security
SHOPIFY_OAUTH_STATE_SECRET=
SHOPIFY_TOKEN_ENCRYPTION_SECRET=

# LLM layer (provider + model are swappable)
LLM_PROVIDER=opencode-server
LLM_MODEL=gemini-3.1-flash-lite-preview

# External Node AI server (recommended for Vercel deployments)
AI_SERVER_BASE_URL=http://localhost:3100
AI_SERVER_TOKEN=
AI_SERVER_TIMEOUT_MS=600000

# External Expo scaffold service (defaults to AI server values when omitted)
EXPO_SCAFFOLD_SERVER_BASE_URL=http://localhost:3100
EXPO_SCAFFOLD_SERVER_TOKEN=
EXPO_SCAFFOLD_TIMEOUT_MS=240000

# Optional direct fallback (if LLM_PROVIDER=gemini)
VERTEX_API_KEY=
GEMINI_API_KEY=
